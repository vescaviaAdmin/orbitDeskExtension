{
  "manifest_version": 3,
  "name": "Transcript Saver",
  "version": "1.0.0",
  "description": "Extracts and saves page transcripts locally.",

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"]
    }
  ],

  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:3000/*"
  ]
}
